<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.13</version>
    <relativePath/>
  </parent>

  <groupId>com.felixkariuki</groupId>
  <artifactId>insurelog-parent</artifactId>
  <version>2.0.0</version>
  <packaging>pom</packaging>
  <name>Insurance Logging System</name>
  <description>Plug-and-play, PII-safe logging for insurance microservices, with a central server and Grafana dashboards</description>

  <modules>
    <module>insurelog-core</module>
    <module>insurelog-spring-boot-starter</module>
    <module>insurelog-server</module>
    <module>demo-claims-service</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <springdoc.version>2.8.17</springdoc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.felixkariuki</groupId>
        <artifactId>insurelog-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.felixkariuki</groupId>
        <artifactId>insurelog-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
